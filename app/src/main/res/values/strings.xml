    <!-- v1.8 DNS enhancements -->
    <string name="dns_block_mode_title">拦截方式</string>
    <string name="dns_block_mode_description">命中规则时的应答。假地址让广告 SDK 立刻连接失败，比 NXDOMAIN 更快也更少触发重试；如某应用因此弹错误，可切回 NXDOMAIN。</string>
    <string name="dns_block_mode_sinkhole">假地址 0.0.0.0（推荐）</string>
    <string name="dns_block_mode_nxdomain">NXDOMAIN（旧版行为）</string>
    <string name="dns_block_mode_saved">拦截方式已更新</string>
    <string name="dns_full_list_title">扩展规则库（anti-AD）</string>
    <string name="dns_full_list_description">内置约 11 万条 anti-AD 域名，覆盖广告、统计、诈骗与博彩站点。误拦时点击拦截记录可一键加白。</string>
    <string name="dns_strict_title">严格模式</string>
    <string name="dns_strict_description">拦截已知 DoH/DoT 服务器域名，并对已接管解析器的 853 端口回绝握手。开启后浏览器“安全 DNS”和系统私人 DNS 将无法解析。</string>
    <string name="dns_private_dns_warning">检测到系统“私人 DNS”已开启。加密 DNS 会绕过本地过滤，严格模式只能部分补救。如需最强拦截，请在系统设置 → 网络和互联网 → 私人 DNS 中选择“不启用”，或改为与静跳兼容的解析器。</string>
    <string name="dns_rules_action">管理规则与拦截记录</string>
    <string name="dns_attribution">扩展规则库来自 anti-AD（MIT 许可）：github.com/privacy-protection-tools/anti-AD</string>
    <string name="dns_rules_title">DNS 规则与记录</string>

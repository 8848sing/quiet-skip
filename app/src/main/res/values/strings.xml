    <string name="app_rule_continuous_title">持续扫描</string>
    <string name="app_rule_continuous_description">该应用在前台时按灵敏度间隔循环扫描，不因连续巡检次数结束而停止；切换应用或关闭服务后暂停。</string>
    <string name="app_rule_sensitivity_title">灵敏度</string>
    <string name="app_rule_sensitivity_description">只影响当前应用的扫描节奏和无文字广告识别力度。档位越高越积极，误触概率也会略高；建议只对经常弹广告的应用使用“灵敏 / 极速”。</string>
    <string name="app_rule_safety_title">自定义防误触保护</string>
    <string name="app_rule_safety_description">停用通用关闭图标，只允许顶部或右下角的明确跳过按钮；可配置页面暂停词和永不点击词。</string>
    <string name="app_rule_pause_markers_title">暂停自动点击的页面关键词</string>
    <string name="app_rule_pause_markers_hint">每行一个，例如：VideoDetailsActivity、评论、弹幕</string>
    <string name="app_rule_blocked_words_title">永不点击的按钮文字</string>
    <string name="app_rule_blocked_words_hint">每行一个，例如：取消、回复、展开</string>
    <string name="app_rule_keywords_hint">追加跳过文字，例如：跳过推荐</string>
    <string name="app_rule_keywords_help">每行一个短词，仅在当前应用生效。留空则只使用内置规则。</string>
    <string name="app_rule_selectors_title">GKD 风格选择器</string>
    <string name="app_rule_selectors_hint">TextView[text*=&quot;跳过&quot;][visibleToUser=true]</string>
    <string name="app_rule_selectors_help">每行一个选择器。支持类名、text/vid/id/desc、比较运算以及 &gt; &gt;n &lt; &lt;n + - 关系；@ 可标记目标节点。</string>

    <string name="auto_learn_title">自动学习广告域名</string>
    <string name="auto_learn_description">高置信广告域名首次出现就加入并拦截；可疑统计域名出现两次后才加入。</string>
    <string name="auto_learn_manage">查看自动学习域名（%1$d）</string>
